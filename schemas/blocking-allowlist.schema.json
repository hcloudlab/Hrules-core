{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hrules Blocking Allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["research", "validating", "published"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match", "reason", "evidence"],
        "properties": {
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": {"enum": ["domain", "domain_suffix"]},
              "value": {"type": "string", "minLength": 1}
            }
          },
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "expires": {"type": ["string", "null"], "format": "date"}
        }
      }
    }
  }
}
