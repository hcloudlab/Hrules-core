{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Hrules Blocking Classification Record",
  "type":"object","additionalProperties":false,
  "required":["schema_version","candidate_id","ownership","purpose","classifier","classified_at","evidence","reason"],
  "properties":{
    "schema_version":{"const":1},
    "candidate_id":{"type":"string","pattern":"^blk-[a-f0-9]{16}$"},
    "ownership":{"enum":["dedicated_third_party","shared_third_party","unknown"]},
    "purpose":{"enum":["telemetry","analytics","advertising","unknown"]},
    "classifier":{"type":"string","minLength":1},
    "classified_at":{"type":"string","format":"date"},
    "evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "reason":{"type":"string","minLength":1}
  }
}
